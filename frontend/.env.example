# Dev only: where Vite proxies /api requests
VITE_DEV_API_TARGET=http://localhost:5000

# Production only: full API base URL if the API is on a different domain.
# Leave empty when frontend and API are served from the same domain.
VITE_API_URL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXX). Leave empty to turn tracking off.
VITE_GA_ID=
