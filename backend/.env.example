# ---------- Server ----------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/salon_booking
# Set to true for hosted DBs that require SSL (Render, Supabase, Neon, etc.)
DATABASE_SSL=false

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ---------- Salon (opening hours are edited in the admin dashboard) ----------
SALON_NAME=My Salon
# Phone clients can call or text (shown on the Policies page), e.g. 0801 234 5678
SALON_PHONE=
SALON_CURRENCY=USD
SALON_TIMEZONE=America/New_York
SLOT_INTERVAL_MINUTES=15

# ---------- Email (Nodemailer SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-salon-account@gmail.com
# For Gmail, use a 16-character App Password, NOT your normal password
SMTP_PASS=your-app-password
EMAIL_FROM="My Salon <your-salon-account@gmail.com>"
ADMIN_EMAIL=owner@yoursalon.com

# ---------- WhatsApp (optional, Meta WhatsApp Cloud API) ----------
# Once set, customers get a WhatsApp message automatically when the salon confirms their booking.
# The template must be approved in WhatsApp Manager, with a body taking 5 parameters:
# {{1}} name, {{2}} service, {{3}} date & time, {{4}} booking #, {{5}} manage link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=braidsandbeyonds_bookingconfirmed
WHATSAPP_TEMPLATE_LANGUAGE=en
# Country code added to local numbers such as 0801 234 5678
WHATSAPP_DEFAULT_COUNTRY_CODE=234

# ---------- Deposits (optional: Paystack and/or bank transfer) ----------
# Set either or both; clients choose how to pay when both are set.
# Paystack: use sk_test_… to try it, sk_live_… for real money.
# In Paystack → Settings → API Keys & Webhooks, set the webhook URL to <your site>/api/payments/webhook
PAYSTACK_SECRET_KEY=
# Bank transfer: shown to clients; the admin marks the deposit received on the dashboard
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
# Optional second account (clients can pay into either)
BANK2_NAME=
BANK2_ACCOUNT_NAME=
BANK2_ACCOUNT_NUMBER=
DEPOSIT_PERCENT=50
# Minutes an unpaid booking keeps its time slot while the client pays
PAYMENT_HOLD_MINUTES=30
# Cancel at least this many hours before for a full deposit refund…
FREE_CANCELLATION_HOURS=24
# …otherwise this share of the deposit is refunded
LATE_CANCEL_REFUND_PERCENT=50
