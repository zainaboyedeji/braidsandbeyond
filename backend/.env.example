# ---------- Server ----------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/salon_booking
# Set to true for hosted DBs that require SSL (Render, Supabase, Neon, etc.)
DATABASE_SSL=false

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ---------- Business hours (salon local time) ----------
SALON_NAME=My Salon
SALON_CURRENCY=USD
SALON_TIMEZONE=America/New_York
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18
SLOT_INTERVAL_MINUTES=15

# ---------- Email (Nodemailer SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-salon-account@gmail.com
# For Gmail, use a 16-character App Password, NOT your normal password
SMTP_PASS=your-app-password
EMAIL_FROM="My Salon <your-salon-account@gmail.com>"
ADMIN_EMAIL=owner@yoursalon.com
