{
  "name": "salon-booking-app",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "db:init": "npm run db:init -w backend",
    "db:admin": "npm run db:admin -w backend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
